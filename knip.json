{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"]
    },
    "apps/console": {
      "project": ["src/**/*.{ts,tsx,css}"],
      "entry": ["src/**/*.test.{ts,tsx}"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts"],
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"],
      "entry": ["src/**/*.test.ts"]
    },
    "packages/spec": {
      "project": ["src/**/*.ts"],
      "entry": ["src/**/*.test.ts"]
    },
    "packages/compose": {
      "project": ["src/**/*.ts"],
      "entry": ["src/**/*.test.ts"]
    },
    "apps/server": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"],
      "entry": ["src/**/*.test.ts"]
    }
  }
}
