    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atelier/knowledge": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "elysia": "^1.4.30",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
