{
  "name": "@atelier/server",
  "description": "The Atelier v2 server — one deployable, three internal modules (runtime/control/sessions).",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ATELIER_SERVER_MODE=mock bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/server.js --minify --external cpu-features --external '*.node'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check:boundary": "bun run scripts/check-boundaries.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@atelier/compose": "workspace:*",
    "@atelier/spec": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@frak/atelier-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode-ai/sdk": "1.18.30",
    "@sinclair/typebox": "catalog:",
    "async-mutex": "^0.5.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.30",
    "env-paths": "^4.0.0",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "pino": "^10.2.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/ssh2": "^1.15.6",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3"
  }
}
