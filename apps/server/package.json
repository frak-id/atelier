{
  "name": "@atelier/server",
  "description": "The Atelier v2 server — one deployable, three internal modules (runtime/control/sessions).",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ATELIER_SERVER_MODE=mock bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/server.js --minify --external cpu-features --external '*.node'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check:boundary": "bun run scripts/check-boundaries.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.0",
    "@atelier/compose": "workspace:*",
    "@atelier/spec": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@frak/atelier-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "env-paths": "^4.0.0",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/ssh2": "^1.15.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3"
  }
}
