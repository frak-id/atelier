{
  "name": "@atelier/server",
  "description": "The Atelier v2 server — one deployable, three internal modules (runtime/control/sessions).",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ATELIER_SERVER_MODE=mock bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/server.js --minify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check:boundary": "bun run scripts/check-boundaries.ts",
    "typecheck": "tsgo --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@atelier/spec": "workspace:*",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@frak/atelier-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "async-mutex": "^0.5.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.28",
    "jose": "^6.1.3",
    "nanoid": "^5.1.9",
    "pino": "^10.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3"
  }
}
