{
  "name": "@atelier/server",
  "description": "The Atelier server — one deployable, three internal modules (runtime/control/sessions).",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ATELIER_SERVER_MODE=local ATELIER_RUNTIME_BACKEND=docker bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/server.js --minify --external cpu-features --external '*.node'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check:boundary": "bun run scripts/check-boundaries.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@atelier/compose": "workspace:*",
    "@atelier/spec": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@frak/atelier-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "env-paths": "^4.0.0",
    "jose": "^6.2.15",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/ssh2": "^1.15.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0"
  }
}
