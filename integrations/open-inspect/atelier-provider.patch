diff --git a/packages/control-plane/src/sandbox/atelier-rest-client.test.ts b/packages/control-plane/src/sandbox/atelier-rest-client.test.ts
new file mode 100644
index 00000000..5976cd5f
--- /dev/null
+++ b/packages/control-plane/src/sandbox/atelier-rest-client.test.ts
@@ -0,0 +1,335 @@
+/**
+ * Unit tests for AtelierRestClient.
+ *
+ * Tests URL construction, auth headers, request bodies, zod parsing, and
+ * error classification (404/409/4xx/5xx/network/timeout).
+ */
+
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import {
+  AtelierApiError,
+  AtelierConflictError,
+  AtelierNotFoundError,
+  AtelierRestClient,
+  type AtelierCreateSandboxParams,
+  type AtelierRestConfig,
+} from "./atelier-rest-client";
+
+const defaultConfig: AtelierRestConfig = {
+  apiUrl: "https://atelier.test",
+  apiKey: "atl_test-key",
+};
+
+function jsonResponse(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "content-type": "application/json" },
+  });
+}
+
+function emptyResponse(status = 204): Response {
+  return new Response(null, { status });
+}
+
+const jobBody = {
+  id: "job-1",
+  kind: "sandbox-create",
+  status: "running",
+  target: "atelier-1",
+  metadata: { sandboxId: "sb-1" },
+  createdAt: "2026-01-01T00:00:00Z",
+  updatedAt: "2026-01-01T00:00:00Z",
+};
+
+const sandboxBody = {
+  id: "sb-1",
+  status: "running",
+  urls: [],
+  processes: [],
+  metadata: {},
+};
+
+let fetchSpy: ReturnType<typeof vi.fn>;
+
+beforeEach(() => {
+  fetchSpy = vi.fn();
+  vi.stubGlobal("fetch", fetchSpy);
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+describe("AtelierRestClient", () => {
+  describe("constructor validation", () => {
+    it("throws when apiUrl is missing", () => {
+      expect(() => new AtelierRestClient({ ...defaultConfig, apiUrl: "" })).toThrow(
+        "requires apiUrl"
+      );
+    });
+
+    it("throws when apiKey is missing", () => {
+      expect(() => new AtelierRestClient({ ...defaultConfig, apiKey: "" })).toThrow(
+        "requires apiKey"
+      );
+    });
+
+    it("tolerates a trailing slash on apiUrl and appends /v1", async () => {
+      const client = new AtelierRestClient({ ...defaultConfig, apiUrl: "https://atelier.test///" });
+      fetchSpy.mockResolvedValue(jsonResponse(sandboxBody));
+      await client.getSandbox("sb-1");
+      expect(fetchSpy).toHaveBeenCalledWith(
+        "https://atelier.test/v1/sandboxes/sb-1",
+        expect.anything()
+      );
+    });
+  });
+
+  describe("auth headers", () => {
+    it("sends Bearer token and JSON content-type", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse(sandboxBody));
+
+      await client.getSandbox("sb-1");
+
+      const [, init] = fetchSpy.mock.calls[0];
+      expect(init.headers).toEqual(
+        expect.objectContaining({
+          Authorization: "Bearer atl_test-key",
+          "Content-Type": "application/json",
+        })
+      );
+    });
+  });
+
+  describe("createSandbox", () => {
+    it("POSTs /v1/sandboxes with the exact request body and parses the job", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse(jobBody, 202));
+
+      const params: AtelierCreateSandboxParams = {
+        source: { image: "open-inspect" },
+        resources: { vcpus: 2, memoryMb: 4096 },
+        processes: [
+          {
+            name: "open-inspect",
+            command: "/opt/openinspect/python/bin/python -m sandbox_runtime.entrypoint",
+            user: "dev",
+            cwd: "/home/dev",
+            env: { FOO: "bar" },
+            primary: true,
+          },
+        ],
+        metadata: { name: "sb-1" },
+        personalize: false,
+      };
+
+      const job = await client.createSandbox(params);
+
+      const [url, init] = fetchSpy.mock.calls[0];
+      expect(url).toBe("https://atelier.test/v1/sandboxes");
+      expect(init.method).toBe("POST");
+      expect(JSON.parse(init.body as string)).toEqual(params);
+      expect(job.id).toBe("job-1");
+      expect(job.metadata?.sandboxId).toBe("sb-1");
+    });
+
+    it("redacts the request body (which carries session secrets) from a create error message", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(
+        jsonResponse(
+          { error: "VALIDATION_ERROR", message: "SANDBOX_AUTH_TOKEN=leaked-secret" },
+          400
+        )
+      );
+
+      await expect(
+        client.createSandbox({
+          source: { image: "open-inspect" },
+          resources: { vcpus: 2, memoryMb: 4096 },
+          processes: [
+            {
+              name: "open-inspect",
+              command: "cmd",
+              user: "dev",
+              cwd: "/home/dev",
+              env: {},
+              primary: true,
+            },
+          ],
+          metadata: {},
+          personalize: false,
+        })
+      ).rejects.toMatchObject({
+        message: expect.not.stringContaining("leaked-secret"),
+      });
+    });
+  });
+
+  describe("getJob", () => {
+    it("GETs /v1/jobs/:id", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse(jobBody));
+
+      const job = await client.getJob("job-1");
+
+      expect(fetchSpy).toHaveBeenCalledWith(
+        "https://atelier.test/v1/jobs/job-1",
+        expect.objectContaining({ method: "GET" })
+      );
+      expect(job.status).toBe("running");
+    });
+
+    it("throws AtelierApiError on an invalid job body", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse({ id: "job-1" }));
+
+      await expect(client.getJob("job-1")).rejects.toBeInstanceOf(AtelierApiError);
+    });
+  });
+
+  describe("getSandbox", () => {
+    it("GETs /v1/sandboxes/:id", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse(sandboxBody));
+
+      const sandbox = await client.getSandbox("sb-1");
+
+      expect(fetchSpy).toHaveBeenCalledWith(
+        "https://atelier.test/v1/sandboxes/sb-1",
+        expect.objectContaining({ method: "GET" })
+      );
+      expect(sandbox.status).toBe("running");
+    });
+  });
+
+  describe("pauseSandbox", () => {
+    it("POSTs /v1/sandboxes/:id/pause with no body and parses ref/hash", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse({ ref: "snap-1", hash: "abc" }));
+
+      const result = await client.pauseSandbox("sb-1");
+
+      const [url, init] = fetchSpy.mock.calls[0];
+      expect(url).toBe("https://atelier.test/v1/sandboxes/sb-1/pause");
+      expect(init.method).toBe("POST");
+      expect(init.body).toBeUndefined();
+      expect(result).toEqual({ ref: "snap-1", hash: "abc" });
+    });
+  });
+
+  describe("resumeSandbox", () => {
+    it("POSTs /v1/sandboxes/:id/resume with an empty JSON object body", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse(sandboxBody));
+
+      await client.resumeSandbox("sb-1");
+
+      const [url, init] = fetchSpy.mock.calls[0];
+      expect(url).toBe("https://atelier.test/v1/sandboxes/sb-1/resume");
+      expect(init.method).toBe("POST");
+      expect(JSON.parse(init.body as string)).toEqual({});
+    });
+  });
+
+  describe("deleteSandbox", () => {
+    it("DELETEs /v1/sandboxes/:id", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(emptyResponse(204));
+
+      await client.deleteSandbox("sb-1");
+
+      expect(fetchSpy).toHaveBeenCalledWith(
+        "https://atelier.test/v1/sandboxes/sb-1",
+        expect.objectContaining({ method: "DELETE" })
+      );
+    });
+  });
+
+  describe("error mapping", () => {
+    it("maps 404 to AtelierNotFoundError", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse({ error: "NOT_FOUND", message: "not found" }, 404));
+
+      await expect(client.getSandbox("sb-1")).rejects.toBeInstanceOf(AtelierNotFoundError);
+    });
+
+    it("maps 409 to AtelierConflictError", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse({ error: "CONFLICT", message: "not paused" }, 409));
+
+      await expect(client.resumeSandbox("sb-1")).rejects.toBeInstanceOf(AtelierConflictError);
+    });
+
+    it("maps other 4xx to AtelierApiError with the status and provider code", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(
+        jsonResponse({ error: "VALIDATION_ERROR", message: "bad request" }, 400)
+      );
+
+      try {
+        await client.getSandbox("sb-1");
+        expect.unreachable("expected rejection");
+      } catch (error) {
+        expect(error).toBeInstanceOf(AtelierApiError);
+        const apiError = error as AtelierApiError;
+        expect(apiError.status).toBe(400);
+        expect(apiError.code).toBe("VALIDATION_ERROR");
+      }
+    });
+
+    it("maps 5xx to AtelierApiError with the status", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(jsonResponse({ error: "INTERNAL_ERROR", message: "boom" }, 500));
+
+      await expect(client.getSandbox("sb-1")).rejects.toMatchObject({
+        status: 500,
+      });
+    });
+
+    it("propagates a network failure", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockRejectedValue(new TypeError("fetch failed"));
+
+      await expect(client.getSandbox("sb-1")).rejects.toThrow("fetch failed");
+    });
+
+    it("maps a timeout to an Error whose message says timeout", async () => {
+      vi.useFakeTimers();
+      try {
+        const client = new AtelierRestClient(defaultConfig);
+        fetchSpy.mockImplementation(
+          (_url: string, init: RequestInit) =>
+            new Promise((_resolve, reject) => {
+              init.signal?.addEventListener("abort", () => {
+                const abortError = new Error("The operation was aborted");
+                abortError.name = "AbortError";
+                reject(abortError);
+              });
+            })
+        );
+
+        const promise = client.getSandbox("sb-1");
+        const assertion = expect(promise).rejects.toThrow(/timeout/i);
+        await vi.runAllTimersAsync();
+        await assertion;
+      } finally {
+        vi.useRealTimers();
+      }
+    });
+
+    it("redacts the API key from an error body excerpt", async () => {
+      const client = new AtelierRestClient(defaultConfig);
+      fetchSpy.mockResolvedValue(
+        jsonResponse(
+          { error: "VALIDATION_ERROR", message: `key ${defaultConfig.apiKey} invalid` },
+          400
+        )
+      );
+
+      await expect(client.getSandbox("sb-1")).rejects.toMatchObject({
+        message: expect.not.stringContaining(defaultConfig.apiKey),
+      });
+    });
+  });
+});
diff --git a/packages/control-plane/src/sandbox/atelier-rest-client.ts b/packages/control-plane/src/sandbox/atelier-rest-client.ts
new file mode 100644
index 00000000..fa837cc9
--- /dev/null
+++ b/packages/control-plane/src/sandbox/atelier-rest-client.ts
@@ -0,0 +1,392 @@
+/**
+ * Direct REST client for the Atelier sandbox API.
+ *
+ * All endpoints live under `${apiUrl}/v1`, Bearer-authenticated with an
+ * Atelier API key. `POST /v1/sandboxes` only enqueues a `sandbox-create` job
+ * (202) carrying the pre-allocated sandbox id in `metadata.sandboxId`; the
+ * provider polls `GET /v1/jobs/:id` until the job settles.
+ */
+
+import { createLogger } from "../logger";
+import { z } from "zod";
+
+const log = createLogger("atelier-rest-client");
+
+export interface AtelierRestConfig {
+  /** Atelier server origin, e.g. "https://atelier.example.com" (a trailing slash is tolerated). */
+  apiUrl: string;
+  /** Atelier API key ("atl_..."), sent as Bearer. */
+  apiKey: string;
+}
+
+// ---------------------------------------------------------------------------
+// Per-operation timeouts (ms)
+// ---------------------------------------------------------------------------
+
+/** The create call itself only enqueues a job; it does not wait for the boot. */
+const TIMEOUT_CREATE_MS = 30_000;
+const TIMEOUT_JOB_GET_MS = 15_000;
+const TIMEOUT_SANDBOX_GET_MS = 15_000;
+/** Awaited: the disk is snapshotted and compute released before this returns. */
+const TIMEOUT_PAUSE_MS = 60_000;
+/** Awaited: reuses the same disk and restarts the declared processes, then returns booted. */
+const TIMEOUT_RESUME_MS = 120_000;
+const TIMEOUT_DELETE_MS = 30_000;
+
+/** Longest provider error body kept on an error message. */
+const MAX_ERROR_BODY_CHARS = 300;
+
+// ---------------------------------------------------------------------------
+// Wire shapes
+// ---------------------------------------------------------------------------
+
+export const ATELIER_JOB_STATUSES = [
+  "queued",
+  "running",
+  "succeeded",
+  "failed",
+  "canceled",
+] as const;
+export type AtelierJobStatus = (typeof ATELIER_JOB_STATUSES)[number];
+
+export const ATELIER_SANDBOX_STATUSES = [
+  "creating",
+  "running",
+  "paused",
+  "stopped",
+  "error",
+] as const;
+export type AtelierSandboxStatus = (typeof ATELIER_SANDBOX_STATUSES)[number];
+
+const optionalString = z.string().nullish().catch(undefined);
+
+const atelierJobSchema = z.object({
+  id: z.string(),
+  kind: z.string(),
+  status: z.enum(ATELIER_JOB_STATUSES),
+  target: optionalString,
+  /** `metadata.sandboxId` is the Atelier sandbox id, pre-allocated at create. */
+  metadata: z.record(z.string(), z.string()).nullish().catch(undefined),
+  error: optionalString,
+  result: z.unknown().optional(),
+  createdAt: optionalString,
+  updatedAt: optionalString,
+});
+
+export type AtelierJob = z.infer<typeof atelierJobSchema>;
+
+const atelierSandboxSchema = z.object({
+  id: z.string(),
+  status: z.enum(ATELIER_SANDBOX_STATUSES),
+  metadata: z.record(z.string(), z.string()).nullish().catch(undefined),
+});
+
+export type AtelierSandbox = z.infer<typeof atelierSandboxSchema>;
+
+const atelierPauseResponseSchema = z.object({
+  ref: z.string(),
+  hash: z.string(),
+});
+
+export type AtelierPauseResponse = z.infer<typeof atelierPauseResponseSchema>;
+
+// ---------------------------------------------------------------------------
+// Request types
+// ---------------------------------------------------------------------------
+
+export interface AtelierCreateSandboxProcess {
+  name: string;
+  command: string;
+  user: string;
+  cwd: string;
+  env: Record<string, string>;
+  primary: true;
+}
+
+export interface AtelierCreateSandboxParams {
+  source: { image: string };
+  resources: { vcpus: number; memoryMb: number };
+  processes: [AtelierCreateSandboxProcess];
+  metadata: Record<string, string>;
+  /**
+   * Must be `false`: Open-Inspect brokers its own git credentials via a
+   * system credential helper baked into the image, and Atelier must not
+   * apply the calling user's personal environment (toolboxes, harness,
+   * git identity) on top of it.
+   */
+  personalize: false;
+}
+
+// ---------------------------------------------------------------------------
+// Errors
+// ---------------------------------------------------------------------------
+
+/** Thrown when Atelier returns 404 — the resource no longer exists. */
+export class AtelierNotFoundError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "AtelierNotFoundError";
+  }
+}
+
+/** Thrown when Atelier returns 409 — the sandbox is not in a state the call accepts. */
+export class AtelierConflictError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "AtelierConflictError";
+  }
+}
+
+/**
+ * Non-404/409 Atelier API error. Carries the HTTP status for classification
+ * and, when Atelier reported one, its own error code.
+ *
+ * The message never carries the request body: `processes[0].env` carries the
+ * session's secrets (SANDBOX_AUTH_TOKEN and any user env vars), and an error
+ * message reaches structured logs and failure tooltips.
+ */
+export class AtelierApiError extends Error {
+  constructor(
+    message: string,
+    public readonly status: number,
+    public readonly code?: string
+  ) {
+    super(message);
+    this.name = "AtelierApiError";
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Client
+// ---------------------------------------------------------------------------
+
+type AtelierMethod = "DELETE" | "GET" | "POST";
+
+interface AtelierRequest {
+  method: AtelierMethod;
+  path: string;
+  timeoutMs: number;
+  body?: unknown;
+  signal?: AbortSignal;
+  /** Drop the response body from the error message — set on the create call, whose body carries secrets. */
+  redactBody?: boolean;
+}
+
+export class AtelierRestClient {
+  private readonly baseUrl: string;
+
+  constructor(public readonly config: AtelierRestConfig) {
+    if (!config.apiUrl) {
+      throw new Error("AtelierRestClient requires apiUrl");
+    }
+    if (!config.apiKey) {
+      throw new Error("AtelierRestClient requires apiKey");
+    }
+    this.baseUrl = `${trimTrailingSlashes(config.apiUrl)}/v1`;
+  }
+
+  // -----------------------------------------------------------------------
+  // Sandbox lifecycle
+  // -----------------------------------------------------------------------
+
+  /** Enqueue a sandbox create. Returns the job record; the caller polls {@link getJob}. */
+  async createSandbox(
+    params: AtelierCreateSandboxParams,
+    signal?: AbortSignal
+  ): Promise<AtelierJob> {
+    const startMs = Date.now();
+    try {
+      return await this.requestJson(atelierJobSchema, {
+        method: "POST",
+        path: "/sandboxes",
+        timeoutMs: TIMEOUT_CREATE_MS,
+        body: params,
+        signal,
+        redactBody: true,
+      });
+    } finally {
+      log.info("atelier.create_sandbox", { duration_ms: Date.now() - startMs });
+    }
+  }
+
+  async getJob(jobId: string, signal?: AbortSignal): Promise<AtelierJob> {
+    return this.requestJson(atelierJobSchema, {
+      method: "GET",
+      path: `/jobs/${encodeURIComponent(jobId)}`,
+      timeoutMs: TIMEOUT_JOB_GET_MS,
+      signal,
+    });
+  }
+
+  async getSandbox(id: string, signal?: AbortSignal): Promise<AtelierSandbox> {
+    return this.requestJson(atelierSandboxSchema, {
+      method: "GET",
+      path: `/sandboxes/${encodeURIComponent(id)}`,
+      timeoutMs: TIMEOUT_SANDBOX_GET_MS,
+      signal,
+    });
+  }
+
+  /** Snapshot the disk, release compute, keep the volume. 409 when not `running`. */
+  async pauseSandbox(id: string, signal?: AbortSignal): Promise<AtelierPauseResponse> {
+    return this.requestJson(atelierPauseResponseSchema, {
+      method: "POST",
+      path: `/sandboxes/${encodeURIComponent(id)}/pause`,
+      timeoutMs: TIMEOUT_PAUSE_MS,
+      signal,
+    });
+  }
+
+  /** Resume from the same disk, restarting declared processes. 409 unless `paused`/`error`. Body must be `{}`. */
+  async resumeSandbox(id: string, signal?: AbortSignal): Promise<AtelierSandbox> {
+    return this.requestJson(atelierSandboxSchema, {
+      method: "POST",
+      path: `/sandboxes/${encodeURIComponent(id)}/resume`,
+      timeoutMs: TIMEOUT_RESUME_MS,
+      body: {},
+      signal,
+    });
+  }
+
+  /** Allowed from any status. 404 is the caller's to treat as already-deleted. */
+  async deleteSandbox(id: string, signal?: AbortSignal): Promise<void> {
+    await this.requestVoid({
+      method: "DELETE",
+      path: `/sandboxes/${encodeURIComponent(id)}`,
+      timeoutMs: TIMEOUT_DELETE_MS,
+      signal,
+    });
+  }
+
+  // -----------------------------------------------------------------------
+  // Internals
+  // -----------------------------------------------------------------------
+
+  private getHeaders(): Record<string, string> {
+    return {
+      "Content-Type": "application/json",
+      Authorization: `Bearer ${this.config.apiKey}`,
+    };
+  }
+
+  /**
+   * Request whose success body is required: it must be JSON and must satisfy
+   * `schema`, otherwise the call fails as an invalid response.
+   */
+  private requestJson<T>(schema: z.ZodType<T>, request: AtelierRequest): Promise<T> {
+    return this.send(request, async (response) =>
+      this.parseJson(schema, await response.text(), response.status)
+    );
+  }
+
+  /** Command whose success body carries nothing we act on (204 or an empty/unused 200). */
+  private requestVoid(request: AtelierRequest): Promise<void> {
+    return this.send<void>(request, () => {});
+  }
+
+  private parseJson<T>(schema: z.ZodType<T>, text: string, status: number): T {
+    let payload: unknown;
+    try {
+      payload = JSON.parse(text);
+    } catch {
+      throw new AtelierApiError("Invalid Atelier API response", status);
+    }
+    const parsed = schema.safeParse(payload);
+    if (!parsed.success) {
+      throw new AtelierApiError("Invalid Atelier API response", status);
+    }
+    return parsed.data;
+  }
+
+  private async send<T>(
+    request: AtelierRequest,
+    consume: (response: Response) => T | Promise<T>
+  ): Promise<T> {
+    const url = `${this.baseUrl}${request.path}`;
+    const controller = new AbortController();
+    const timeoutId = setTimeout(() => controller.abort(), request.timeoutMs);
+
+    try {
+      const init: RequestInit = {
+        method: request.method,
+        headers: this.getHeaders(),
+        signal: request.signal
+          ? AbortSignal.any([controller.signal, request.signal])
+          : controller.signal,
+      };
+      if (request.body !== undefined) {
+        init.body = JSON.stringify(request.body);
+      }
+
+      const response = await fetch(url, init);
+
+      if (response.status === 404) {
+        await response.text();
+        throw new AtelierNotFoundError(`Atelier resource not found: ${request.path}`);
+      }
+      if (response.status === 409) {
+        await response.text();
+        throw new AtelierConflictError(`Atelier conflict: ${request.path}`);
+      }
+
+      if (!response.ok) {
+        const text = await response.text();
+        const code = this.errorCode(text);
+        throw new AtelierApiError(
+          this.errorMessage(request, response.status, text),
+          response.status,
+          code
+        );
+      }
+
+      return await consume(response);
+    } catch (error) {
+      // Not an AtelierApiError: a plain Error whose message says "timeout" so the
+      // provider's network-error classifier (SandboxProviderError.isTransientNetworkError)
+      // recognizes it as transient without an HTTP status to key off of.
+      if (error instanceof Error && error.name === "AbortError") {
+        throw new Error(
+          `Atelier request timeout after ${request.timeoutMs}ms (${request.method} ${request.path})`
+        );
+      }
+      throw error;
+    } finally {
+      clearTimeout(timeoutId);
+    }
+  }
+
+  private errorCode(body: string): string | undefined {
+    try {
+      const parsed = JSON.parse(body) as { error?: unknown };
+      return typeof parsed.error === "string" ? parsed.error : undefined;
+    } catch {
+      return undefined;
+    }
+  }
+
+  private errorMessage(request: AtelierRequest, status: number, body: string): string {
+    const endpoint = `${request.method} ${request.path}`;
+    if (request.redactBody) {
+      return `Atelier API error ${status} on ${endpoint}`;
+    }
+    const excerpt = this.sanitizeBody(body);
+    return excerpt
+      ? `Atelier API error ${status} on ${endpoint}: ${excerpt}`
+      : `Atelier API error ${status} on ${endpoint}`;
+  }
+
+  private sanitizeBody(body: string): string {
+    const redacted = body.split(this.config.apiKey).join("[redacted]").trim();
+    return redacted.length > MAX_ERROR_BODY_CHARS
+      ? `${redacted.slice(0, MAX_ERROR_BODY_CHARS)}...`
+      : redacted;
+  }
+}
+
+function trimTrailingSlashes(url: string): string {
+  return url.replace(/\/+$/, "");
+}
+
+export function createAtelierRestClient(config: AtelierRestConfig): AtelierRestClient {
+  return new AtelierRestClient(config);
+}
