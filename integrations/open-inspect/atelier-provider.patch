+/**
+ * Atelier sandbox provider — calls the Atelier REST API directly.
+ *
+ * Modeled on `daytona-provider.ts` (persistent resume + explicit stop): an
+ * ordinary stop pauses the sandbox (disk kept, compute released) and the next
+ * spawn resumes it in place.
+ *
+ * v1 limits:
+ * - No prebuilt repo/environment images: "atelier" is not an image-build
+ *   provider, so every session boots from `ATELIER_IMAGE` and
+ *   `FROM_REPO_IMAGE` is always "false".
+ * - No browser access extras (code-server, terminal, VNC, tunnel URLs):
+ *   Atelier's in-pod agent owns 0.0.0.0:7681 and forwards declared ports from
+ *   0.0.0.0, which collides with services that bind the pod interface
+ *   themselves. No Atelier `ports` are declared and no access URLs returned.
+ */
+
+import { createLogger } from "../../logger";
+import type { SourceControlProviderName } from "../../source-control";
+import type {
+  AtelierCreateSandboxParams,
+  AtelierJob,
+  AtelierRestClient,
+} from "../atelier-rest-client";
+import {
+  AtelierApiError,
+  AtelierConflictError,
+  AtelierNotFoundError,
+} from "../atelier-rest-client";
+import {
+  buildSandboxEnvVars,
+  DEFERRED_START_ENV_VAR,
+  IMAGE_BUILD_MODE_ENV_VAR,
+  scmCloneIdentity,
+  type ScmCloneIdentity,
+} from "../sandbox-env";
+import type { SandboxPortPlan } from "./port-resolution";
+import {
+  SandboxProviderError,
+  signalUntilDeadline,
+  type CreateSandboxConfig,
+  type CreateSandboxResult,
+  type ResumeConfig,
+  type ResumeResult,
+  type SandboxProvider,
+  type SandboxProviderCapabilities,
+  type StopConfig,
+  type StopResult,
+} from "../provider";
+
+const log = createLogger("atelier-provider");
+
+// ---------------------------------------------------------------------------
+// Constants
+// ---------------------------------------------------------------------------
+
+/** Atelier seed image name, when `ATELIER_IMAGE` is unset. Defined once, here. */
+export const DEFAULT_ATELIER_IMAGE = "open-inspect";
+
+/** Provider default vCPUs, when `sandboxSettings.cpuCores` is unset or null. */
+const DEFAULT_ATELIER_VCPUS = 2;
+/** Provider default memory (MiB), when `sandboxSettings.memoryMib` is unset or null. */
+const DEFAULT_ATELIER_MEMORY_MB = 4096;
+const MIN_ATELIER_VCPUS = 1;
+const MIN_ATELIER_MEMORY_MB = 256;
+
+/**
+ * How long a create waits for the Atelier `sandbox-create` job.
+ *
+ * The job succeeds once the runtime process has started, which is when its
+ * bridge connects. Keep this just under `CONNECT_WATCHDOG_MS`
+ * (`sandbox/lifecycle/decisions.ts`), after which the sandbox is judged dead
+ * anyway: waiting longer buys nothing, and failing first reports Atelier's own
+ * error instead of a generic connect timeout. A first boot on a node that has
+ * not pulled the image yet may exceed it; pre-pull the image rather than
+ * raising this past the watchdog.
+ */
+const ATELIER_CREATE_TIMEOUT_MS = 200_000;
+/** How often the create job is re-read while waiting. */
+const CREATE_JOB_POLL_INTERVAL_MS = 3_000;
+
+const ATELIER_PROCESS_NAME = "open-inspect";
+const ATELIER_PROCESS_COMMAND = "/opt/openinspect/python/bin/python -m sandbox_runtime.entrypoint";
+const ATELIER_PROCESS_USER = "dev";
+const ATELIER_PROCESS_CWD = "/home/dev";
+
+/**
+ * Browser access extras are unsupported (see module docstring), so every
+ * service and tunnel port stays disabled whatever the session settings ask.
+ */
+const ATELIER_PORT_PLAN: SandboxPortPlan = {
+  reservedPorts: [],
+  extraTunnelPorts: [],
+  allExposedPorts: [],
+};
+
+// ---------------------------------------------------------------------------
+// Provider config
+// ---------------------------------------------------------------------------
+
+export interface AtelierProviderConfig {
+  scmProvider: SourceControlProviderName;
+  /** Atelier image to boot sessions from — `ATELIER_IMAGE`, else `DEFAULT_ATELIER_IMAGE`. */
+  image: string;
+}
+
+// ---------------------------------------------------------------------------
+// Provider
+// ---------------------------------------------------------------------------
+
+export class AtelierSandboxProvider implements SandboxProvider {
+  readonly name = "atelier";
+
+  readonly capabilities: SandboxProviderCapabilities = {
+    supportsSandboxTimeout: false,
+    supportsSnapshots: false,
+    supportsRestore: false,
+    supportsPersistentResume: true,
+    supportsExplicitStop: true,
+  };
+
+  constructor(
+    private readonly client: AtelierRestClient,
+    private readonly providerConfig: AtelierProviderConfig
+  ) {}
+
+  // -----------------------------------------------------------------------
+  // SandboxProvider interface
+  // -----------------------------------------------------------------------
+
+  async createSandbox(config: CreateSandboxConfig): Promise<CreateSandboxResult> {
+    warnUnsupportedAccess(config);
+    try {
+      const envVars = this.buildEnvVars(config);
+      const resources = resolveAtelierResources(config.sandboxSettings);
+
+      const body: AtelierCreateSandboxParams = {
+        source: { image: this.providerConfig.image },
+        resources,
+        processes: [
+          {
+            name: ATELIER_PROCESS_NAME,
+            command: ATELIER_PROCESS_COMMAND,
+            user: ATELIER_PROCESS_USER,
+            cwd: ATELIER_PROCESS_CWD,
+            env: envVars,
+            primary: true,
+          },
+        ],
+        metadata: this.buildMetadata(config),
+        personalize: false,
+      };
+
+      const job = await this.client.createSandbox(body);
+      const atelierSandboxId = job.metadata?.sandboxId;
+      if (!atelierSandboxId) {
+        throw new SandboxProviderError(
+          "Atelier sandbox create did not return a sandbox id in job metadata",
+          "permanent"
+        );
+      }
+
+      await this.waitForCreateJob(job.id, atelierSandboxId);
+
+      return {
+        sandboxId: config.sandboxId,
+        providerObjectId: atelierSandboxId,
+        createdAt: Date.now(),
+        lifetime: { kind: "none", observedAtMs: Date.now() },
+      };
+    } catch (error) {
+      if (error instanceof SandboxProviderError) throw error;
+      throw classifyAtelierError("Failed to create Atelier sandbox", error);
+    }
+  }
+
+  async resumeSandbox(config: ResumeConfig): Promise<ResumeResult> {
+    try {
+      let sandbox;
+      try {
+        sandbox = await this.client.getSandbox(config.providerObjectId);
+      } catch (error) {
+        if (error instanceof AtelierNotFoundError) {
+          return {
+            success: false,
+            error: "Sandbox no longer exists in Atelier",
+            shouldSpawnFresh: true,
+          };
+        }
+        throw error;
+      }
+
+      if (sandbox.status === "running") {
+        return {
+          success: true,
+          providerObjectId: sandbox.id,
+          lifetime: { kind: "none", observedAtMs: Date.now() },
+        };
+      }
+
+      if (sandbox.status === "paused" || sandbox.status === "error") {
+        try {
+          await this.client.resumeSandbox(config.providerObjectId);
+        } catch (error) {
+          if (!(error instanceof AtelierConflictError)) throw error;
+          // Raced another resume (or a delete): judge by the state it left.
+          return await this.resumeResultAfterConflict(config.providerObjectId);
+        }
+        return {
+          success: true,
+          providerObjectId: config.providerObjectId,
+          lifetime: { kind: "none", observedAtMs: Date.now() },
+        };
+      }
+
+      if (sandbox.status === "stopped") {
+        return {
+          success: false,
+          error: "Sandbox is stopped in Atelier",
+          shouldSpawnFresh: true,
+        };
+      }
+
+      // "creating": mid-boot from an earlier create — neither resumable in
+      // place nor safe to replace yet.
+      return { success: false, error: "Sandbox is still being created in Atelier" };
+    } catch (error) {
+      if (error instanceof SandboxProviderError) throw error;
+      throw classifyAtelierError("Failed to resume Atelier sandbox", error);
+    }
+  }
+
+  async stopSandbox(config: StopConfig): Promise<StopResult> {
+    const signal = signalUntilDeadline(config.deadlineAtMs, config.signal);
+    try {
+      try {
+        if (config.intent === "destroy") {
+          await this.client.deleteSandbox(config.providerObjectId, signal);
+        } else {
+          try {
+            await this.client.pauseSandbox(config.providerObjectId, signal);
+          } catch (error) {
+            if (error instanceof AtelierConflictError) {
+              const reread = await this.client.getSandbox(config.providerObjectId, signal);
+              if (reread.status === "paused") return { success: true };
+              return {
+                success: false,
+                error: `Sandbox state was ${reread.status} after pause conflict`,
+              };
+            }
+            throw error;
+          }
+        }
+      } catch (error) {
+        if (error instanceof AtelierNotFoundError) {
+          if (config.intent === "preserve") {
+            return {
+              success: false,
+              error: "Sandbox disappeared before graceful shutdown was verified",
+            };
+          }
+          return { success: true };
+        }
+        throw error;
+      }
+      return { success: true };
+    } catch (error) {
+      if (error instanceof SandboxProviderError) throw error;
+      throw classifyAtelierError(
+        `Failed to ${config.intent === "destroy" ? "delete" : "pause"} Atelier sandbox`,
+        error
+      );
+    }
+  }
+
+  // -----------------------------------------------------------------------
+  // Env var assembly
+  // -----------------------------------------------------------------------
+
+  /**
+   * The session env, delivered on the **process** (`processes[0].env`), not
+   * the spec-level `env`: spec-level env is exported to every login shell in
+   * the sandbox, and the session auth token must stay scoped to the runtime
+   * process.
+   */
+  private buildEnvVars(config: CreateSandboxConfig): Record<string, string> {
+    const envVars = buildSandboxEnvVars(config, {
+      scmIdentity: this.cloneIdentity(),
+      portPlan: ATELIER_PORT_PLAN,
+      emitDisabledTerminalEnv: true,
+    });
+
+    // Boot markers are stated explicitly, never merely omitted (see
+    // daytona-provider.ts for why): a value baked into an image can never
+    // decide how a session boots. Atelier has no snapshot/prebuilt-image
+    // support, so RESTORED_FROM_SNAPSHOT and FROM_REPO_IMAGE are always
+    // "false" — the OI_REPO_IMAGE_* callback-contract keys are never set.
+    Object.assign(envVars, {
+      [DEFERRED_START_ENV_VAR]: "false",
+      [IMAGE_BUILD_MODE_ENV_VAR]: "false",
+      RESTORED_FROM_SNAPSHOT: "false",
+      FROM_REPO_IMAGE: "false",
+    });
+    return envVars;
+  }
+
+  private async resumeResultAfterConflict(providerObjectId: string): Promise<ResumeResult> {
+    let sandbox;
+    try {
+      sandbox = await this.client.getSandbox(providerObjectId);
+    } catch (error) {
+      if (error instanceof AtelierNotFoundError) {
+        return {
+          success: false,
+          error: "Sandbox no longer exists in Atelier",
+          shouldSpawnFresh: true,
+        };
+      }
+      throw error;
+    }
+    if (sandbox.status === "running") {
+      return {
+        success: true,
+        providerObjectId: sandbox.id,
+        lifetime: { kind: "none", observedAtMs: Date.now() },
+      };
+    }
+    return { success: false, error: `Sandbox state was ${sandbox.status} after resume conflict` };
+  }
+
+  private cloneIdentity(): ScmCloneIdentity {
+    return scmCloneIdentity(this.providerConfig.scmProvider);
+  }
+
+  private buildMetadata(config: CreateSandboxConfig): Record<string, string> {
+    const metadata: Record<string, string> = {
+      name: `open-inspect-${config.sandboxId}`,
+      "open-inspect.session-id": config.sessionId,
+      "open-inspect.sandbox-id": config.sandboxId,
+    };
+    if (config.repoOwner && config.repoName) {
+      metadata["open-inspect.repo"] = `${config.repoOwner}/${config.repoName}`;
+    }
+    return metadata;
+  }
+
+  // -----------------------------------------------------------------------
+  // Create-job polling
+  // -----------------------------------------------------------------------
+
+  /**
+   * Wait for the `sandbox-create` job to settle. On `failed`/`canceled` or at
+   * the deadline, best-effort delete the pre-allocated sandbox before throwing,
+   * so a failed create never leaks it. A transient error reading the job is
+   * retried on the next poll: a single blip must not fail a healthy boot.
+   */
+  private async waitForCreateJob(jobId: string, atelierSandboxId: string): Promise<void> {
+    const deadlineAtMs = Date.now() + ATELIER_CREATE_TIMEOUT_MS;
+    for (;;) {
+      const job = await this.readCreateJob(jobId, atelierSandboxId);
+      if (job?.status === "succeeded") return;
+
+      if (job?.status === "failed" || job?.status === "canceled") {
+        await this.bestEffortDelete(atelierSandboxId);
+        throw new SandboxProviderError(
+          `Atelier sandbox create job ${job.status}: ${job.error ?? "no error message reported"}`,
+          "permanent"
+        );
+      }
+
+      if (Date.now() >= deadlineAtMs) {
+        await this.bestEffortDelete(atelierSandboxId);
+        throw new SandboxProviderError(
+          `Atelier sandbox create job did not complete within ${ATELIER_CREATE_TIMEOUT_MS}ms`,
+          "transient"
+        );
+      }
+
+      await delay(CREATE_JOB_POLL_INTERVAL_MS);
+    }
+  }
+
+  /** The job, or undefined when reading it failed transiently. */
+  private async readCreateJob(
+    jobId: string,
+    atelierSandboxId: string
+  ): Promise<AtelierJob | undefined> {
+    try {
+      return await this.client.getJob(jobId);
+    } catch (error) {
+      const classified = classifyAtelierError("Failed to read Atelier create job", error);
+      if (classified.errorType === "permanent") throw classified;
+      log.warn("atelier.create_job_poll_failed", {
+        sandbox_id: atelierSandboxId,
+        error: classified.message,
+      });
+      return undefined;
+    }
+  }
+
+  private async bestEffortDelete(atelierSandboxId: string): Promise<void> {
+    try {
+      await this.client.deleteSandbox(atelierSandboxId);
+    } catch (error) {
+      if (error instanceof AtelierNotFoundError) return;
+      log.warn("atelier.cleanup_delete_failed", {
+        sandbox_id: atelierSandboxId,
+        error: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+/** Log what a session asked for that Atelier cannot provide (see module docstring). */
+function warnUnsupportedAccess(config: CreateSandboxConfig): void {
+  const settings = config.sandboxSettings;
+  const requested = [
+    config.codeServerEnabled && "code-server",
+    config.vncEnabled && "vnc",
+    settings?.terminalEnabled && "terminal",
+    settings?.tunnelPorts?.length && "tunnel ports",
+  ].filter(Boolean);
+  if (requested.length > 0) {
+    log.warn("atelier.access_unsupported", {
+      session_id: config.sessionId,
+      requested: requested.join(", "),
+    });
+  }
+}
+
+function delay(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+/**
+ * `sandboxSettings.cpuCores`/`memoryMib` → Atelier `resources`, per the
+ * contract: `vcpus = max(1, ceil(cpuCores))`, `memoryMb = max(256,
+ * round(memoryMib))`, provider defaults (2 vCPUs, 4096 MiB) when a setting is
+ * unset or explicitly null.
+ */
+function resolveAtelierResources(sandboxSettings: CreateSandboxConfig["sandboxSettings"]): {
+  vcpus: number;
+  memoryMb: number;
+} {
+  const cpuCores = sandboxSettings?.cpuCores;
+  const memoryMib = sandboxSettings?.memoryMib;
+  const vcpus =
+    cpuCores === undefined || cpuCores === null
+      ? DEFAULT_ATELIER_VCPUS
+      : Math.max(MIN_ATELIER_VCPUS, Math.ceil(cpuCores));
+  const memoryMb =
+    memoryMib === undefined || memoryMib === null
+      ? DEFAULT_ATELIER_MEMORY_MB
+      : Math.max(MIN_ATELIER_MEMORY_MB, Math.round(memoryMib));
+  return { vcpus, memoryMb };
+}
+
+/**
+ * The control-plane classification of a failed Atelier call.
+ *
+ * HTTP 429 and every 5xx are transient (rate limiting and
+ * provider-side failure are both worth retrying without tripping the circuit
+ * breaker); every other 4xx is permanent. `SandboxProviderError.isTransientStatus`
+ * only recognizes 502/503/504, so this classifies 429/5xx directly rather than
+ * deferring to it.
+ */
+function classifyAtelierError(message: string, error: unknown): SandboxProviderError {
+  if (error instanceof AtelierApiError) {
+    const transient = error.status === 429 || error.status >= 500;
+    return new SandboxProviderError(
+      `${message}: ${error.message}`,
+      transient ? "transient" : "permanent",
+      error
+    );
+  }
+  if (error instanceof AtelierNotFoundError || error instanceof AtelierConflictError) {
+    return SandboxProviderError.fromFetchError(`${message}: ${error.message}`, error);
+  }
+  return SandboxProviderError.fromFetchError(message, error);
+}
+
+// ---------------------------------------------------------------------------
+// Factory
+// ---------------------------------------------------------------------------
+
+export function createAtelierProvider(
+  client: AtelierRestClient,
+  providerConfig: AtelierProviderConfig
+): AtelierSandboxProvider {
+  return new AtelierSandboxProvider(client, providerConfig);
+}
