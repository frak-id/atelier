--- /dev/null
+++ b/packages/control-plane/src/sandbox/providers/atelier-provider.test.ts
@@ -0,0 +1,570 @@
+/**
+ * Unit tests for AtelierSandboxProvider.
+ *
+ * Tests create (env assembly, resources, boot markers, job polling, failure
+ * cleanup), resume state handling, and stop preserve/destroy paths. `fetch`
+ * is not touched — the Atelier REST client is mocked directly.
+ */
+
+import { describe, it, expect, vi, afterEach, beforeEach } from "vitest";
+import {
+  AtelierConflictError,
+  AtelierNotFoundError,
+  type AtelierJob,
+  type AtelierRestClient,
+  type AtelierSandbox,
+} from "../atelier-rest-client";
+import { SandboxProviderError } from "../provider";
+import type { CreateSandboxConfig, ResumeConfig, StopConfig } from "../provider";
+import {
+  AtelierSandboxProvider,
+  DEFAULT_ATELIER_IMAGE,
+  type AtelierProviderConfig,
+} from "./atelier-provider";
+
+// ==================== Mock factories ====================
+
+function createMockClient(
+  overrides: Partial<{
+    createSandbox: (params: unknown) => Promise<AtelierJob>;
+    getJob: (id: string) => Promise<AtelierJob>;
+    getSandbox: (id: string) => Promise<AtelierSandbox>;
+    pauseSandbox: (id: string) => Promise<{ ref: string; hash: string }>;
+    resumeSandbox: (id: string) => Promise<AtelierSandbox>;
+    deleteSandbox: (id: string) => Promise<void>;
+  }> = {}
+): AtelierRestClient {
+  return {
+    createSandbox: vi.fn(
+      async (): Promise<AtelierJob> => ({
+        id: "job-1",
+        kind: "sandbox-create",
+        status: "succeeded",
+        metadata: { sandboxId: "atelier-sb-1" },
+      })
+    ),
+    getJob: vi.fn(
+      async (): Promise<AtelierJob> => ({
+        id: "job-1",
+        kind: "sandbox-create",
+        status: "succeeded",
+        metadata: { sandboxId: "atelier-sb-1" },
+      })
+    ),
+    getSandbox: vi.fn(
+      async (): Promise<AtelierSandbox> => ({ id: "atelier-sb-1", status: "running" })
+    ),
+    pauseSandbox: vi.fn(async () => ({ ref: "snap-1", hash: "abc" })),
+    resumeSandbox: vi.fn(
+      async (): Promise<AtelierSandbox> => ({ id: "atelier-sb-1", status: "running" })
+    ),
+    deleteSandbox: vi.fn(async () => {}),
+    ...overrides,
+  } as unknown as AtelierRestClient;
+}
+
+const defaultProviderConfig: AtelierProviderConfig = {
+  scmProvider: "github",
+  image: DEFAULT_ATELIER_IMAGE,
+};
+
+const baseCreateConfig: CreateSandboxConfig = {
+  sessionId: "session-123",
+  sandboxId: "sandbox-456",
+  repoOwner: "testowner",
+  repoName: "testrepo",
+  controlPlaneUrl: "https://control-plane.test",
+  sandboxAuthToken: "auth-token-abc",
+  harness: "opencode" as const,
+  provider: "anthropic",
+  model: "anthropic/claude-sonnet-4-5",
+};
+
+const baseResumeConfig: ResumeConfig = {
+  providerObjectId: "atelier-sb-1",
+  sessionId: "session-123",
+  sandboxId: "sandbox-456",
+};
+
+const baseStopConfig: StopConfig = {
+  providerObjectId: "atelier-sb-1",
+  sessionId: "session-123",
+  reason: "inactivity_timeout",
+  intent: "preserve",
+};
+
+describe("AtelierSandboxProvider", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.restoreAllMocks();
+  });
+
+  describe("capabilities", () => {
+    it("reports correct capabilities", () => {
+      const provider = new AtelierSandboxProvider(createMockClient(), defaultProviderConfig);
+      expect(provider.name).toBe("atelier");
+      expect(provider.capabilities).toEqual({
+        supportsSandboxTimeout: false,
+        supportsSnapshots: false,
+        supportsRestore: false,
+        supportsPersistentResume: true,
+        supportsExplicitStop: true,
+      });
+    });
+  });
+
+  describe("createSandbox", () => {
+    it("happy path: sends the exact request body and returns providerObjectId with lifetime none", async () => {
+      const client = createMockClient();
+      const provider = new AtelierSandboxProvider(client, defaultProviderConfig);
+
+      const result = await provider.createSandbox(baseCreateConfig);
+
+      expect(result.sandboxId).toBe("sandbox-456");
+      expect(result.providerObjectId).toBe("atelier-sb-1");
+      expect(result.createdAt).toBeGreaterThan(0);
+      expect(result.lifetime).toMatchObject({ kind: "none" });
+      // No access URLs of any kind — browser extras are unsupported.
+      expect(result.codeServerUrl).toBeUndefined();
+      expect(result.ttydUrl).toBeUndefined();
+      expect(result.vncAccess).toBeUndefined();
+      expect(result.tunnelUrls).toBeUndefined();
+
