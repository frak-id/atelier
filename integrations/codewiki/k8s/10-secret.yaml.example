# Template only — never apply this file as-is or commit real values.
#
# GITHUB_TOKEN: only needed if any CODEWIKI_REPOS entry is private. A
#   fine-grained PAT, Contents: Read is enough (same shape as
#   integrations/onyx/terraform's GitHub connector token, but this one only
#   ever touches `git fetch`, never the GitHub API).
# LLM_API_KEY: the cliproxy bearer key (same one apps/server and Onyx's own
#   onyx_llm_provider.cliproxy use — see integrations/onyx/terraform/llm.tf).
# ONYX_API_KEY: `terraform output wiki_sync_api_key` from
#   integrations/onyx/terraform (integrations/onyx/terraform/api_keys.tf,
#   onyx_api_key.wiki_sync) — only returned once, at creation.
#
# kubectl -n onyx create secret generic codewiki-sync-secrets \
#   --from-literal=GITHUB_TOKEN='<fine-grained PAT, or omit for public repos>' \
#   --from-literal=LLM_API_KEY='<cliproxy bearer key>' \
#   --from-literal=ONYX_API_KEY='<terraform output wiki_sync_api_key>'
apiVersion: v1
kind: Secret
metadata:
  name: codewiki-sync-secrets
  namespace: onyx
type: Opaque
stringData:
  GITHUB_TOKEN: "REPLACE_ME_OR_OMIT_FOR_PUBLIC_REPOS"
  LLM_API_KEY: "REPLACE_ME"
  ONYX_API_KEY: "REPLACE_ME"
